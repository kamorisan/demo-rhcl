# RHCL Chatbot - Environment Variables Example
# Copy this file to .env and fill in the actual values

# MCP Gateway Configuration
RHCL_MCP_BASE_URL=http://mcp.sandbox356.opentlc.com/mcp
RHCL_MCP_TIMEOUT_SECONDS=10

# OpenAI Compatible LLM API Configuration
RHCL_OPENAI_BASE_URL=https://litellm-prod.apps.maas.redhatworkshops.io/v1
RHCL_OPENAI_MODEL=deepseek-r1-distill-qwen-14b
RHCL_OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_ACTUAL_API_KEY
RHCL_OPENAI_TIMEOUT_SECONDS=15

# Chatbot Configuration
RHCL_CHATBOT_DEFAULT_DATES_RANGE=7

# Quarkus Configuration
QUARKUS_HTTP_PORT=8080
QUARKUS_HTTP_CORS=true
