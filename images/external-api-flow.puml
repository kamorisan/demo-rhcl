@startuml external-api-flow
!define ICONURL https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/v2.4.0
!include ICONURL/common.puml
!include ICONURL/font-awesome-5/user.puml
!include ICONURL/font-awesome-5/globe.puml
!include ICONURL/font-awesome-5/server.puml
!include ICONURL/font-awesome-5/lock.puml
!include ICONURL/font-awesome-5/shield_alt.puml
!include ICONURL/font-awesome-5/football_ball.puml

skinparam defaultTextAlignment center
skinparam componentStyle rectangle
skinparam backgroundColor white
skinparam shadowing false
skinparam nodesep 60
skinparam ranksep 80

title External API (ESPN Proxy) Complete Data Flow\n(DNS → TLS → Gateway Policy Override → External API Proxy)

actor "Browser" as browser <<$user>>
cloud "Internet" as internet <<$globe>>
cloud "External\nESPN API" as espn_api <<$football_ball>> #Orange

package "AWS" {
  cloud "Route53\n(Public DNS)" as route53 #Khaki

  component "AWS Load\nBalancer" as awslb #Orange

  package "OpenShift Cluster" {
    component "OpenShift Router\nIngress Controller\n(SNI passthrough)" as router #LightBlue

    package "cert-manager" {
      component "ClusterIssuer\n(Let's Encrypt)" as issuer <<$lock>> #LightPink
      component "Certificate\nrhcl-gw-public-tls" as cert <<$lock>> #LightPink
      component "TLS Secret" as secret <<$lock>> #LightPink
    }

    package "Gateway\n(openshift-ingress)" {
      component "Gateway\nrhcl-workshop-gw\nListener: https-external-public\n(TLS termination)" as gateway #LightGreen
      component "TLSPolicy" as tlspolicy #Wheat
      component "AuthPolicy\nrhcl-gw-auth\n(default deny)" as gw_auth <<$shield_alt>> #Pink
    }

    package "HTTPRoute\n(demo)" {
      component "HTTPRoute\nexternal-proxy-public\n(/nba, /epl, /laliga, /nfl, /nhl)" as httproute #LightCyan
      component "AuthPolicy\nexternal-proxy-public-allow\n(route-level allow)" as route_auth <<$shield_alt>> #LightGreen
    }

    component "DNSPolicy" as dnspolicy #Wheat

    package "Backend\n(ESPN Proxy)" {
      component "Service\nespn-proxy" as service #LightSteelBlue
      component "Pod\nespn-proxy" as pod <<$server>> #LightGray
    }
  }
}

' ===== Data Plane: Runtime Request/Response Path (Solid lines) =====

' Step 1: DNS Resolution
browser -down-> route53 : "①DNS Query\nexternal-api.sandbox2689.opentlc.com"
route53 -up-> browser : "DNS Response\n→ AWS LB IP"

' Step 2-6: HTTPS Request Path
browser -down-> internet : "②HTTPS Request\nGET /nba or /epl"
internet -down-> awslb : "To LB IP:443"
awslb -down-> router : "③SNI routing"
router -down-> gateway : "④TLS passthrough\nvia OpenShift Route\n→ Gateway Service"
gateway -down-> httproute : "⑤Route match\n/nba, /epl, etc."
httproute -down-> service : "⑥Forward\n(auth allowed)"
service -down-> pod

' Step 7: External API Call
pod -down-> internet : "⑦Proxy request\nto ESPN API"
internet -down-> espn_api : "GET ESPN API\n(external)"
espn_api -up-> internet : "ESPN API response\n(JSON data)"
internet -up-> pod : "Receive external\nAPI response"

' Response Path
pod -up-> service : "Response\n(ESPN data)"
service -up-> httproute
httproute -up-> gateway
gateway -up-> router
router -up-> awslb
awslb -up-> internet
internet -up-> browser : "200 OK\n(ESPN data)"

' ===== Control Plane: Policy/Management (Dashed lines) =====

' DNS Management
dnspolicy .down.> route53 : "Manages DNS records\nvia Route53 API"
dnspolicy .down.> gateway : "Watches Gateway\nhostname/address"

' TLS Management
tlspolicy .right.> cert : "Requests\ncertificate"
cert .up.> issuer : "Uses\nissuer"
issuer .down.> cert : "Issues cert\n(cert-manager\nreconcile)"
cert .right.> secret : "Creates\nTLS Secret"
secret .down.> gateway : "certificateRefs\nin listener"

' Policy Application
tlspolicy .down.> gateway : "Applies to"
gw_auth .down.> gateway : "Applies to"
route_auth .down.> httproute : "Applies to\n(overrides deny)"

' Notes
note right of route53
**Route53 Public DNS**
- Browser queries Route53 for DNS
- Returns AWS LB IP
- Dedicated hostname:
  external-api.<domain>

**DNSPolicy (Control Plane)**
- Manages DNS records via Route53 API
- Watches Gateway hostname/address
- Creates/updates DNS records
end note

note right of awslb
**AWS Load Balancer**
- Outside OpenShift Cluster
- AWS managed infrastructure
- Routes to OpenShift Router
end note

note right of router
**SNI Passthrough**
- Router does NOT terminate TLS
- SNI-based routing to Gateway
- TLS remains encrypted
- Uses OpenShift Route resource
- Route generated for Gateway
  listener hostname
end note

note right of gateway
**TLS Termination at Gateway/Envoy**
- Gateway/Envoy terminates TLS
- Uses Secret from cert-manager
- Decrypts HTTPS traffic

**Listener: https-external-public**
- Dedicated listener for external API
- Hostname: external-api.<domain>
- Certificate SAN includes:
  external-api.<domain>

**Policy Evaluation**
①Gateway AuthPolicy (default deny)
②Route AuthPolicy (allow) → Override
③Allow request to backend
end note

note right of gw_auth
**Gateway-level AuthPolicy**
- Default protection
- deny-all by default
- Applies to all HTTPRoutes
- Can be overridden by
  route-specific policies
end note

note right of route_auth
**Route-level AuthPolicy**
- Route-specific allow
- Overrides Gateway deny-all
- Allows public access to
  external API endpoints
- No authentication required
  for these specific paths

**Purpose:**
- Selective override of deny-all
- Public access to ESPN proxy
- Gateway still protects other routes
end note

note right of httproute
**HTTPRoute: external-proxy-public**
- Paths:
  • /nba (NBA scores)
  • /epl (Premier League)
  • /laliga (La Liga)
  • /nfl (NFL scores)
  • /nhl (NHL scores)

**Features:**
- Clean path mapping
- Public access (no auth)
- Proxies to external ESPN API
end note

note right of service
**Backend: ESPN Proxy**
- Proxies requests to external ESPN API
- Handles external API authentication
  (if required)
- Transforms/formats responses
- Caches data (optional)

**Benefits:**
- Single entry point for external data
- Can apply Gateway policies
  (rate-limit, traffic shaping)
- Decouples external API from clients
end note

note right of espn_api
**External ESPN API**
- Third-party service
- Outside OpenShift Cluster
- Provides sports data
- Pod makes outbound HTTPS request
end note

note right of cert
**cert-manager**
- Certificate uses ClusterIssuer
- cert-manager reconciles
  Certificate resource
- Creates TLS Secret
- DNS-01 challenge via Route53
- Auto renewal
- SAN includes:
  external-api.<domain>
end note

' Legend
legend bottom left
**Flow Types:**
━━━ Solid line = Data Plane (runtime request/response)
┄┄┄ Dashed line = Control Plane (policy/management/reconcile)

**Response Codes:**
• 200 = Success (ESPN data returned)
• 403 = Forbidden (if route-level allow not configured)
• 404 = Not Found (invalid path)
• 502 = Bad Gateway (ESPN API unavailable)

**Architecture:**
• AWS Load Balancer: Outside OpenShift Cluster
• Route53: AWS managed DNS service
• OpenShift Router: Inside OpenShift Cluster
• Gateway/HTTPRoute/Backend: Inside OpenShift Cluster
• ESPN API: External third-party service

**Key Concepts:**
• Dedicated hostname: external-api.<domain>
• Gateway deny-all + Route allow = selective override
• Backend proxies to external API
• Same Gateway policies can apply (auth/rate-limit/traffic)
• Clean separation of internal vs external data sources

**Steps:**
① DNS Query → Response (Route53)
② HTTPS Request to external-api hostname
③ SNI routing (AWS LB → Router)
④ TLS passthrough (Router → Gateway via OpenShift Route)
⑤ Route matching (Gateway → HTTPRoute)
⑥ Gateway deny-all → Route allow (override)
⑦ Forward to ESPN Proxy backend
⑧ Backend makes external API call
⑨ ESPN API responds
⑩ Backend returns data to browser
endlegend

@enduml
