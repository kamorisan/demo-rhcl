@startuml policy-playground-flow
!define ICONURL https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/v2.4.0
!include ICONURL/common.puml
!include ICONURL/font-awesome-5/user.puml
!include ICONURL/font-awesome-5/globe.puml
!include ICONURL/font-awesome-5/server.puml
!include ICONURL/font-awesome-5/shield_alt.puml
!include ICONURL/font-awesome-5/tachometer_alt.puml
!include ICONURL/font-awesome-5/lock.puml

skinparam defaultTextAlignment center
skinparam componentStyle rectangle
skinparam backgroundColor white
skinparam shadowing false
skinparam nodesep 80
skinparam ranksep 100
left to right direction

title Policy Playground Complete Data Flow\n(DNS → TLS → API Keys → Rate Limiting)

actor "ブラウザ" as browser <<$user>>

package "AWS" {
  component "Route53" as route53 #Khaki
  component "DNSPolicy" as dnspolicy #Wheat
}

cloud "Internet" as internet <<$globe>>

package "OpenShift Cluster" {
  component "Router\n(LoadBalancer)" as router #LightBlue

  package "cert-manager" {
    component "Certificate" as cert <<$lock>> #LightPink
    component "ClusterIssuer" as issuer #LightPink
  }

  package "Gateway\n(openshift-ingress)" {
    component "Gateway\nrhcl-workshop-gw" as gateway #Orange
    component "TLSPolicy" as tlspolicy <<$lock>> #LightPink
    component "AuthPolicy\nrhcl-gw-auth" as gw_auth <<$shield_alt>> #Pink
  }

  package "HTTPRoute\n(demo)" {
    component "HTTPRoute\ndemo-api" as httproute #LightGreen
    component "AuthPolicy\napi-key" as route_auth <<$shield_alt>> #Pink
    component "RateLimitPolicy\nidentity-based" as ratelimit <<$tachometer_alt>> #Yellow
  }

  package "Backend\n(demo)" {
    component "Service\ndemo-api" as service #LightCyan
    component "Pod\ndemo-api" as pod <<$server>> #LightGray
  }
}

' DNS Resolution
browser -right-> route53 : "①DNS Query"
route53 -left-> browser : "DNS Response"

' Request flow
browser -right-> internet : "②HTTPS\nGET /hello"
internet -right-> router : "To IP:443"
router -right-> gateway : "③TLS\nPassthrough"
gateway -right-> httproute : "④Route\nMatch"
httproute -right-> service : "⑤Forward"
service -right-> pod

' Response flow
pod -left-> service
service -left-> httproute
httproute -left-> gateway
gateway -left-> router
router -left-> internet
internet -left-> browser

' Management relationships
route53 <-down-> dnspolicy : "管理"
gateway -up-> dnspolicy

' TLS Management
gateway -down-> tlspolicy
tlspolicy -down-> cert
cert -down-> issuer

' Policy Application
gateway -down-> gw_auth
httproute -down-> route_auth
httproute -down-> ratelimit

' Note - DNS
note top of route53
**Route53 DNS**
A/AAAA record
rhcl-workshop.
  sandbox2689.opentlc.com
→ Router IP
end note

' Note - TLS
note bottom of cert
**TLS Certificate**
Let's Encrypt
DNS-01 Challenge
Auto renewal
end note

' Note - Gateway Auth
note bottom of gw_auth
**Gateway Policy**
deny-all (default)
path != '/health'
end note

' Note - Route Auth
note bottom of route_auth
**API Key Auth**
IAMALICE → alice
IAMBOB → bob
Invalid → 401/403
end note

' Note - Rate Limit
note bottom of ratelimit
**Rate Limit**
Alice: 5 req/10s
Bob: 2 req/10s
Over → 429
end note

' Policy Evaluation
note top of gateway
**Policy評価**
①Gateway Auth
②Route Auth
③Rate Limit
④Pass→Backend
⑤Fail→Error
end note

' Legend
legend bottom left
|= Flow |
| ① DNS Query → Response |
| ② HTTPS Request |
| ③ TLS Passthrough (SNI) |
| ④ Route Matching |
| ⑤ Forward to Backend |

|= Response |
| 200 Success |
| 401/403 Unauthorized |
| 429 Rate Limit |
endlegend

@enduml
