@startuml policy-playground-flow
!define ICONURL https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/v2.4.0
!include ICONURL/common.puml
!include ICONURL/font-awesome-5/user.puml
!include ICONURL/font-awesome-5/globe.puml
!include ICONURL/font-awesome-5/server.puml
!include ICONURL/font-awesome-5/shield_alt.puml
!include ICONURL/font-awesome-5/tachometer_alt.puml
!include ICONURL/font-awesome-5/lock.puml

skinparam defaultTextAlignment center
skinparam componentStyle rectangle
skinparam backgroundColor white
skinparam shadowing false
skinparam nodesep 60
skinparam ranksep 80

title Policy Playground Complete Data Flow\n(DNS → TLS → API Keys → Rate Limiting)

actor "ブラウザ" as browser <<$user>>

cloud "Internet" as internet <<$globe>>

package "AWS" {
  component "Route53" as route53 #Khaki
  component "DNSPolicy" as dnspolicy #Wheat

  package "OpenShift Cluster" {
    component "Router\n(LoadBalancer)" as router #LightBlue

    package "cert-manager" {
      component "Certificate" as cert <<$lock>> #LightPink
      component "ClusterIssuer" as issuer #LightPink
    }

    package "Gateway\n(openshift-ingress)" {
      component "Gateway\nrhcl-workshop-gw" as gateway #Orange
      component "TLSPolicy" as tlspolicy <<$lock>> #LightPink
      component "AuthPolicy\nrhcl-gw-auth" as gw_auth <<$shield_alt>> #Pink
    }

    package "HTTPRoute\n(demo)" {
      component "HTTPRoute\ndemo-api" as httproute #LightGreen
      component "AuthPolicy\napi-key" as route_auth <<$shield_alt>> #Pink
      component "RateLimitPolicy\nidentity-based" as ratelimit <<$tachometer_alt>> #Yellow
    }

    package "Backend\n(demo)" {
      component "Service\ndemo-api" as service #LightCyan
      component "Pod\ndemo-api" as pod <<$server>> #LightGray
    }
  }
}

' DNS Resolution
browser -down-> route53 : "①DNS Query"
route53 -up-> browser : "DNS Response"

' Request flow (top to bottom)
browser -down-> internet : "②HTTPS\nGET /hello"
internet -down-> router : "To Router IP:443"
router -down-> gateway : "③TLS\nPassthrough"
gateway -down-> httproute : "④Route\nMatch"
httproute -down-> service : "⑤Forward"
service -down-> pod

' Response flow (bottom to top)
pod -up-> service
service -up-> httproute
httproute -up-> gateway
gateway -up-> router
router -up-> internet
internet -up-> browser

' Management relationships
route53 <-right-> dnspolicy : "管理"
gateway -left-> dnspolicy

' TLS Management
gateway -right-> tlspolicy
tlspolicy -right-> cert
cert -right-> issuer

' Policy Application
gateway -right-> gw_auth
httproute -right-> route_auth
httproute -right-> ratelimit

' Note - DNS
note right of route53
**Route53 DNS**
A/AAAA record
rhcl-workshop.
  sandbox2689.opentlc.com
→ Router IP
end note

' Note - TLS
note right of cert
**TLS Certificate**
Let's Encrypt
DNS-01 Challenge
Auto renewal
end note

' Note - Gateway Auth
note right of gw_auth
**Gateway Policy**
deny-all (default)
path != '/health'
end note

' Note - Route Auth
note right of route_auth
**API Key Auth**
IAMALICE → alice
IAMBOB → bob
Invalid → 401/403
end note

' Note - Rate Limit
note right of ratelimit
**Rate Limit**
Alice: 5 req/10s
Bob: 2 req/10s
Over → 429
end note

' Policy Evaluation
note left of gateway
**Policy評価**
①Gateway Auth
②Route Auth
③Rate Limit
④Pass→Backend
⑤Fail→Error
end note

' Legend
legend right
|= Flow |
| ① DNS Query → Response |
| ② HTTPS Request |
| ③ TLS Passthrough (SNI) |
| ④ Route Matching |
| ⑤ Forward to Backend |

|= Response |
| 200 Success |
| 401/403 Unauthorized |
| 429 Rate Limit |

|= 構成 |
| OpenShift Cluster on AWS |
| Route53: DNS管理 |
| Router: AWS LoadBalancer |
endlegend

@enduml
