@startuml policy-playground-flow
!define ICONURL https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/v2.4.0
!include ICONURL/common.puml
!include ICONURL/font-awesome-5/user.puml
!include ICONURL/font-awesome-5/globe.puml
!include ICONURL/font-awesome-5/server.puml
!include ICONURL/font-awesome-5/shield_alt.puml
!include ICONURL/font-awesome-5/tachometer_alt.puml
!include ICONURL/font-awesome-5/lock.puml

skinparam defaultTextAlignment center
skinparam componentStyle rectangle
skinparam backgroundColor white
skinparam shadowing false
left to right direction

title Policy Playground Complete Data Flow\n(DNS → TLS → API Keys → Rate Limiting)

actor "ブラウザ" as browser <<$user>>

package "AWS" {
  component "Route53\nDNS Service" as route53 #Khaki
  component "DNSPolicy\n(auto-manage)" as dnspolicy #Wheat
}

cloud "Internet" as internet <<$globe>>

package "OpenShift Cluster" {
  component "OpenShift\nRouter\n(LoadBalancer)" as router #LightBlue

  package "cert-manager" {
    component "Certificate" as certificate <<$lock>> #LightPink
    component "ClusterIssuer\n(Let's Encrypt)" as clusterissuer #LightPink
  }

  package "Gateway\n(openshift-ingress)" {
    component "Gateway\nrhcl-workshop-gw\n(TLS Termination)" as gateway #Orange
    component "TLSPolicy" as tlspolicy <<$lock>> #LightPink
    component "AuthPolicy\nrhcl-gw-auth\n(deny-by-default)" as gateway_auth <<$shield_alt>> #Pink
  }

  package "HTTPRoute\n(demo ns)" {
    component "HTTPRoute\ndemo-api\n(/hello)" as httproute #LightGreen
    component "AuthPolicy\ndemo-api-auth\n(API Key)" as route_auth <<$shield_alt>> #Pink
    component "RateLimitPolicy\ndemo-api-rlp\n(identity-based)" as ratelimit <<$tachometer_alt>> #Yellow
  }

  package "Backend\n(demo ns)" {
    component "Service\ndemo-api" as service #LightCyan
    component "Pod\ndemo-api" as pod <<$server>> #LightGray
  }
}

' Step 1: DNS Resolution (bidirectional)
browser -right-> route53 : "1. DNS Query\nrhcl-workshop.sandbox2689.opentlc.com"
route53 -left-> browser : "DNS Response\nIP: Router LB"

' Step 2-5: Request flow (left to right)
browser -right-> internet : "2. HTTPS Request\nGET /hello\nAPIKEY IAMALICE"
internet -right-> router : "To Router IP:443"
router -right-> gateway : "3. TLS Passthrough\n(SNI)"
gateway -right-> httproute : "4. Route Match\n/hello"
httproute -right-> service : "5. Forward"
service -right-> pod : "Process"

' Response flow (right to left)
pod -left-> service : "Response"
service -left-> httproute : "Response"
httproute -left-> gateway : "Response"
gateway -left-> router : "Response"
router -left-> internet : "Response"
internet -left-> browser : "Response"

' DNS Management
route53 -down-> dnspolicy : "管理される"
gateway -up-> dnspolicy : "参照"

' TLS Management
gateway -down-> tlspolicy : "適用"
tlspolicy -down-> certificate : "管理"
certificate -down-> clusterissuer : "発行"

' Policy Application
gateway -down-> gateway_auth : "適用"
httproute -down-> route_auth : "適用"
httproute -down-> ratelimit : "適用"

' Notes - DNS
note top of route53
  **AWS Route53 DNS**
  - A/AAAA record
  - rhcl-workshop.sandbox2689.opentlc.com
  - → Router LoadBalancer IP
  - TTL: 60s
  - DNSPolicyで自動管理
end note

' Notes - TLS
note bottom of certificate
  **TLS Certificate**
  - Let's Encrypt証明書
  - DNS-01 Challenge (Route53)
  - cert-managerが自動取得・更新
  - TLSPolicyで自動化
  - Secret: rhcl-workshop-tls
end note

' Notes - Gateway Auth
note bottom of gateway_auth
  **Gateway Policy (defaults)**
  - すべてのHTTPRouteに適用
  - deny-all (403)
  - Condition: path != '/health'
  - Route Policyでoverride可能
end note

' Notes - Route Auth
note bottom of route_auth
  **Route Policy (overrides)**
  - API Key検証
  - IAMALICE → alice
  - IAMBOB → bob
  - Secret: api-keys
  - 無効 → 401/403
end note

' Notes - Rate Limit
note bottom of ratelimit
  **Rate Limit**
  - Alice: 5 req/10s
  - Bob: 2 req/10s
  - Counter: auth.identity.userid
  - 超過 → 429

  **デモ**: Bobが早く429到達
end note

' Policy Evaluation
note top of gateway
  **Policy評価順序**
  1. Gateway AuthPolicy
  2. Route AuthPolicy
  3. RateLimitPolicy
  4. All Pass → Backend
  5. Any Fail → Error
end note

' Legend
legend bottom
  |= Step |= 説明 |
  | 1 | DNS Query → Route53がRouter IPを返答 |
  | 2 | HTTPS Request → Router LoadBalancerへ |
  | 3 | TLS Passthrough → SNIでGatewayへrouting |
  | 4 | Route Match → HTTPRouteのpath matching |
  | 5 | Forward → Backend Serviceへ転送 |

  |= Response Codes |
  | 200 | Success (valid key, under limit) |
  | 401/403 | Unauthorized (invalid API key) |
  | 429 | Too Many Requests (rate limit exceeded) |

  |= Policy適用 (縦矢印) |
  | DNSPolicy | Route53 DNS record自動管理 |
  | TLSPolicy | Certificate自動管理 (cert-manager) |
  | AuthPolicy | 認証・認可 (Gateway/Route level) |
  | RateLimitPolicy | Rate limiting (identity-based) |
endlegend

@enduml
