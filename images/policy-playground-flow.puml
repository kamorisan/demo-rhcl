@startuml policy-playground-flow
!define ICONURL https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/v2.4.0
!include ICONURL/common.puml
!include ICONURL/font-awesome-5/user.puml
!include ICONURL/font-awesome-5/globe.puml
!include ICONURL/font-awesome-5/server.puml
!include ICONURL/font-awesome-5/shield_alt.puml
!include ICONURL/font-awesome-5/tachometer_alt.puml
!include ICONURL/font-awesome-5/lock.puml

skinparam defaultTextAlignment center
skinparam componentStyle rectangle
skinparam backgroundColor white
skinparam shadowing false
skinparam nodesep 60
skinparam ranksep 80

title Policy Playground Complete Data Flow\n(DNS → TLS → API Keys → Rate Limiting)

actor "Browser" as browser <<$user>>
cloud "Internet" as internet <<$globe>>
cloud "Route53\n(Public DNS)" as route53 #Khaki

package "AWS" {
  component "AWS Load\nBalancer" as awslb #Orange

  package "OpenShift Cluster" {
    component "OpenShift Router\nIngress Controller\n(SNI passthrough)" as router #LightBlue

    package "cert-manager" {
      component "ClusterIssuer\n(Let's Encrypt)" as issuer <<$lock>> #LightPink
      component "Certificate" as cert <<$lock>> #LightPink
      component "TLS Secret" as secret <<$lock>> #LightPink
    }

    package "Gateway\n(openshift-ingress)" {
      component "Gateway\nrhcl-workshop-gw\n(TLS termination)" as gateway #LightGreen
      component "TLSPolicy" as tlspolicy #Wheat
      component "AuthPolicy\nrhcl-gw-auth\n(default deny)" as gw_auth <<$shield_alt>> #Pink
    }

    package "HTTPRoute\n(demo)" {
      component "HTTPRoute\ndemo-api" as httproute #LightCyan
      component "AuthPolicy\napi-key\n(route-specific)" as route_auth <<$shield_alt>> #Pink
      component "RateLimitPolicy\nidentity-based" as ratelimit <<$tachometer_alt>> #Yellow
    }

    component "DNSPolicy" as dnspolicy #Wheat

    package "Backend\n(demo)" {
      component "Service\ndemo-api" as service #LightSteelBlue
      component "Pod\ndemo-api" as pod <<$server>> #LightGray
    }
  }
}

' ===== Data Plane: Runtime Request/Response Path (Solid lines) =====

' Step 1: DNS Resolution
browser -down-> route53 : "①DNS Query\nrhcl-workshop.sandbox2689.opentlc.com"
route53 -up-> browser : "DNS Response\n→ AWS LB IP"

' Step 2-6: HTTPS Request Path
browser -down-> internet : "②HTTPS Request\nGET /hello\nAPIKEY IAMALICE"
internet -down-> awslb : "To LB IP:443"
awslb -down-> router : "③SNI routing"
router -down-> gateway : "④TLS passthrough"
gateway -down-> httproute : "⑤Route match\n/hello"
httproute -down-> service : "⑥Forward"
service -down-> pod

' Response Path
pod -up-> service : "Response"
service -up-> httproute
httproute -up-> gateway
gateway -up-> router
router -up-> awslb
awslb -up-> internet
internet -up-> browser : "200/401/403/429"

' ===== Control Plane: Policy/Management (Dashed lines) =====

' DNS Management
dnspolicy .down.> route53 : "Manages DNS\nvia Route53 API"
dnspolicy .down.> gateway : "Watches Gateway\nhostname/address"

' TLS Management
tlspolicy .right.> cert : "Requests\ncertificate"
cert .up.> issuer : "References\nissuer"
issuer .down.> cert : "Issues\ncertificate"
cert .right.> secret : "Stores\ncert/key"
secret .down.> gateway : "certificateRefs"

' Policy Application
tlspolicy .down.> gateway : "Applies to"
gw_auth .down.> gateway : "Applies to"
route_auth .down.> httproute : "Applies to"
ratelimit .down.> httproute : "Applies to"

' Notes
note right of route53
**Route53 DNS**
- Browser queries public DNS
- DNSPolicy does NOT handle
  runtime DNS queries
- DNSPolicy manages DNS records
  via Route53 API (Control Plane)
end note

note right of router
**SNI Passthrough**
- Router does NOT terminate TLS
- SNI-based routing to Gateway
- TLS remains encrypted
end note

note right of gateway
**TLS Termination**
- Gateway/Envoy terminates TLS
- Uses Secret from cert-manager
- Decrypts HTTPS traffic

**Policy Evaluation**
①Gateway AuthPolicy (default deny)
②Route AuthPolicy (API key)
③RateLimitPolicy (identity-based)
end note

note right of gw_auth
**Gateway-level Policy**
- Default protection
- deny-all by default
- Applies to all HTTPRoutes
- Can be overridden by
  route-specific policies
end note

note right of route_auth
**Route-level Policy**
- Route-specific auth
- API Key validation:
  - IAMALICE → alice
  - IAMBOB → bob
- Missing/invalid key → 401
- Authenticated but denied → 403
end note

note right of ratelimit
**Rate Limit**
- Counter: auth.identity.userid
- Alice: 5 req/10s
- Bob: 2 req/10s
- Limit exceeded → 429
end note

note right of cert
**cert-manager**
- Certificate references
  ClusterIssuer
- Obtains cert from
  Let's Encrypt
- DNS-01 challenge
- Stores in Secret
- Auto renewal
end note

' Legend
legend bottom left
**Flow Types:**
━━━ Solid line = Runtime request/response path (Data Plane)
┄┄┄ Dashed line = Policy attachment/management (Control Plane)

**Response Codes:**
• 200 = Success (valid key, under limit)
• 401 = Unauthorized (missing/invalid API key)
• 403 = Forbidden (authenticated but denied)
• 429 = Too Many Requests (rate limit exceeded)

**Steps:**
① DNS Query → Response (Route53)
② HTTPS Request
③ SNI routing (AWS LB → Router)
④ TLS passthrough (Router → Gateway)
⑤ Route matching (Gateway → HTTPRoute)
⑥ Forward to Backend
endlegend

@enduml
