@startuml traffic-shaping-flow
!define ICONURL https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/v2.4.0
!include ICONURL/common.puml
!include ICONURL/font-awesome-5/user.puml
!include ICONURL/font-awesome-5/globe.puml
!include ICONURL/font-awesome-5/server.puml
!include ICONURL/font-awesome-5/lock.puml
!include ICONURL/font-awesome-5/random.puml

skinparam defaultTextAlignment center
skinparam componentStyle rectangle
skinparam backgroundColor white
skinparam shadowing false
skinparam nodesep 60
skinparam ranksep 80

title Traffic Shaping Complete Data Flow\n(DNS → TLS → Weighted Backend Routing → A/B + Canary)

actor "Browser" as browser <<$user>>
cloud "Internet" as internet <<$globe>>

package "AWS" {
  cloud "Route53\n(Public DNS)" as route53 #Khaki

  component "AWS Load\nBalancer" as awslb #Orange

  package "OpenShift Cluster" {
    component "OpenShift Router\nIngress Controller\n(SNI passthrough)" as router #LightBlue

    package "cert-manager" {
      component "ClusterIssuer\n(Let's Encrypt)" as issuer <<$lock>> #LightPink
      component "Certificate" as cert <<$lock>> #LightPink
      component "TLS Secret" as secret <<$lock>> #LightPink
    }

    package "Gateway\n(openshift-ingress)" {
      component "Gateway\nrhcl-workshop-gw\n(TLS termination)" as gateway #LightGreen
      component "TLSPolicy" as tlspolicy #Wheat
    }

    package "HTTPRoute\n(demo)" {
      component "HTTPRoute\ndemo-ab\n(/ab)" as httproute_ab <<$random>> #LightCyan
      component "HTTPRoute\ndemo-canary\n(/canary)" as httproute_canary <<$random>> #LightCyan
      component "HTTPRoute\ndemo-canary-forced\n(/canary + header)" as httproute_forced <<$random>> #LightCyan
    }

    component "DNSPolicy" as dnspolicy #Wheat

    package "Backend v1\n(demo)" {
      component "Service\ndemo-api-v1" as service_v1 #LightSteelBlue
      component "Pod\ndemo-api-v1" as pod_v1 <<$server>> #LightGray
    }

    package "Backend v2\n(demo)" {
      component "Service\ndemo-api-v2" as service_v2 #LightSteelBlue
      component "Pod\ndemo-api-v2" as pod_v2 <<$server>> #LightGray
    }
  }
}

' ===== Data Plane: Runtime Request/Response Path (Solid lines) =====

' Step 1: DNS Resolution
browser -down-> route53 : "①DNS Query\nrhcl-workshop.sandbox2689.opentlc.com"
route53 -up-> browser : "DNS Response\n→ AWS LB IP"

' Step 2-6: HTTPS Request Path
browser -down-> internet : "②HTTPS Request\nGET /ab or /canary"
internet -down-> awslb : "To LB IP:443"
awslb -down-> router : "③SNI routing"
router -down-> gateway : "④TLS passthrough\nvia OpenShift Route\n→ Gateway Service"

' Step 5: Route matching
gateway -down-> httproute_ab : "⑤Route match\n/ab"
gateway -down-> httproute_canary : "⑤Route match\n/canary\n(no header)"
gateway -down-> httproute_forced : "⑤Route match\n/canary\n(header: x-rhcl-canary)"

' Step 6a: A/B split (80/20)
httproute_ab -down-> service_v1 : "⑥Forward\n80% weight"
httproute_ab -down-> service_v2 : "⑥Forward\n20% weight"

' Step 6b: Canary split (90/10)
httproute_canary -down-> service_v1 : "⑥Forward\n90% weight"
httproute_canary -down-> service_v2 : "⑥Forward\n10% weight"

' Step 6c: Canary forced (100% v2)
httproute_forced -down-> service_v2 : "⑥Forward\n100% weight\n(forced to v2)"

' Service to Pod
service_v1 -down-> pod_v1
service_v2 -down-> pod_v2

' Response Path
pod_v1 -up-> service_v1 : "Response\n(v1 content)"
pod_v2 -up-> service_v2 : "Response\n(v2 content)"
service_v1 -up-> httproute_ab
service_v1 -up-> httproute_canary
service_v2 -up-> httproute_ab
service_v2 -up-> httproute_canary
service_v2 -up-> httproute_forced
httproute_ab -up-> gateway
httproute_canary -up-> gateway
httproute_forced -up-> gateway
gateway -up-> router
router -up-> awslb
awslb -up-> internet
internet -up-> browser : "200 OK\n(v1 or v2 response)"

' ===== Control Plane: Policy/Management (Dashed lines) =====

' DNS Management
dnspolicy .down.> route53 : "Manages DNS records\nvia Route53 API"
dnspolicy .down.> gateway : "Watches Gateway\nhostname/address"

' TLS Management
tlspolicy .right.> cert : "Requests\ncertificate"
cert .up.> issuer : "Uses\nissuer"
issuer .down.> cert : "Issues cert\n(cert-manager\nreconcile)"
cert .right.> secret : "Creates\nTLS Secret"
secret .down.> gateway : "certificateRefs\nin listener"

' Policy Application
tlspolicy .down.> gateway : "Applies to"

' Notes
note right of route53
**Route53 Public DNS**
- Browser queries Route53 for DNS
- Returns AWS LB IP
- NOT queried via DNSPolicy

**DNSPolicy (Control Plane)**
- Manages DNS records via Route53 API
- Watches Gateway hostname/address
- Creates/updates DNS records
end note

note right of awslb
**AWS Load Balancer**
- Outside OpenShift Cluster
- AWS managed infrastructure
- Routes to OpenShift Router
end note

note right of router
**SNI Passthrough**
- Router does NOT terminate TLS
- SNI-based routing to Gateway
- TLS remains encrypted
- Uses OpenShift Route resource
- Route generated for Gateway
  listener hostname
end note

note right of gateway
**TLS Termination at Gateway/Envoy**
- Gateway/Envoy terminates TLS
- Uses Secret from cert-manager
- Decrypts HTTPS traffic

**No Authentication/Rate Limiting**
- This demo focuses on traffic shaping
- No AuthPolicy or RateLimitPolicy
- All requests are allowed
end note

note right of httproute_ab
**A/B Testing (Random Split)**
- Path: /ab
- Backend weights:
  • v1: 80%
  • v2: 20%
- Random distribution per request
- Use case: Compare two versions
  with unequal traffic split
end note

note right of httproute_canary
**Canary Rollout (Progressive Delivery)**
- Path: /canary
- No header match
- Backend weights:
  • v1: 90% (stable)
  • v2: 10% (canary)
- Use case: Gradual rollout of new version
  with minimal risk
end note

note right of httproute_forced
**Canary Opt-in (Forced Routing)**
- Path: /canary
- Header match: x-rhcl-canary: always
- Backend weights:
  • v2: 100%
- Use case: Internal testers always get
  canary version for validation
end note

note right of service_v1
**Backend v1 (Stable Version)**
- Receives majority of traffic
- Known stable behavior
- Production-ready code
end note

note right of service_v2
**Backend v2 (New Version)**
- Receives minority of traffic
- Being validated in production
- Can be promoted to stable
  after validation
end note

note right of cert
**cert-manager**
- Certificate uses ClusterIssuer
- cert-manager reconciles
  Certificate resource
- Creates TLS Secret
- DNS-01 challenge via Route53
- Auto renewal
end note

' Legend
legend bottom left
**Flow Types:**
━━━ Solid line = Data Plane (runtime request/response)
┄┄┄ Dashed line = Control Plane (policy/management/reconcile)

**Response Codes:**
• 200 = Success (v1 or v2 response)
• 404 = Not Found (invalid path)

**Architecture:**
• AWS Load Balancer: Outside OpenShift Cluster
• Route53: AWS managed DNS service
• OpenShift Router: Inside OpenShift Cluster
• Gateway/HTTPRoute/Backend: Inside OpenShift Cluster

**Traffic Shaping:**
• A/B (/ab): 80% v1, 20% v2
• Canary (/canary): 90% v1, 10% v2
• Canary forced (/canary + header): 100% v2

**Steps:**
① DNS Query → Response (Route53)
② HTTPS Request
③ SNI routing (AWS LB → Router)
④ TLS passthrough (Router → Gateway via OpenShift Route)
⑤ Route matching (Gateway → HTTPRoute based on path/header)
⑥ Forward to Backend (weighted distribution)
endlegend

@enduml
